{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Debug DVSyncViewer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/dvsense_fusion_sync_viewer",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
